# Discord Bot Authentication Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Database Connection URL
# SQLite default:
DATABASE_URL=sqlite+aiosqlite:///bot.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hayato_bot

# Development Guild ID for instant slash command testing (leave empty for global sync in production)
DEV_GUILD_ID=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Web Server & Verification Portal (Terms & Privacy)
ENABLE_WEB_PORTAL=true
PORT=8080
WEB_HOST=0.0.0.0
